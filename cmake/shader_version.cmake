# Writes OUT = a header defining HWDER_SHADER_VERSION, a hash of the shader translator's sources (SRCS).
# The renderer's shader cache (cache/shaders.bin) stores translated SPIR-V, so it is only valid for the
# translator that produced it. Rewritten only when the value changes, so unrelated rebuilds keep it.
set(acc "")
foreach(f ${SRCS})
    file(SHA1 "${f}" h)
    string(APPEND acc "${h}")
endforeach()
string(SHA1 all "${acc}")
string(SUBSTRING "${all}" 0 16 v)
set(text "// Generated by cmake/shader_version.cmake - do not edit.\n#pragma once\n#define HWDER_SHADER_VERSION 0x${v}ull\n")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
